FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04 AS base

ENV DEBIAN_FRONTEND=noninteractive \
    HF_HOME=/models/huggingface \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_CACHE_DIR=/tmp/uv-cache \
    UV_LINK_MODE=copy

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates \
      git \
      python3 \
      python3-pip \
      python3-venv \
    && python3 -m pip install --break-system-packages --no-cache-dir uv==0.9.11 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/chart

# Build context is the chart repo. The editable hevlayer dependency is copied
# from the sibling checkout through BuildKit:
#   docker buildx build -f deploy/Dockerfile.gpu --build-context layer_client=../layer/clients/python .
COPY --from=layer_client . /opt/layer/clients/python
COPY . /opt/chart

FROM base AS embedder
ARG PRELOAD_EMBED_MODEL=Snowflake/snowflake-arctic-embed-m-v1.5
RUN uv sync --frozen \
    && if [ -n "${PRELOAD_EMBED_MODEL}" ]; then \
      .venv/bin/python -c 'import os; from huggingface_hub import snapshot_download; snapshot_download(os.environ["PRELOAD_EMBED_MODEL"]); print("preloaded embed model", os.environ["PRELOAD_EMBED_MODEL"])'; \
    fi \
    && uv cache clean
CMD ["uv", "run", "python", "-m", "indexer.embed"]

FROM base AS huggingface-source
RUN uv sync --frozen && uv cache clean
CMD ["uv", "run", "python", "-m", "source.huggingface_source"]

FROM base AS classifier
ARG PRELOAD_EVENTS_MODEL=google/gemma-2-9b-it
# gcc + C headers + Python.h: vLLM compiles triton/torch-inductor kernels at
# engine start (triton's cuda_utils is a C Python extension), so the runtime
# CUDA base needs a working native toolchain or the EngineCore dies in a
# load→compile→crash loop.
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev python3-dev \
    && rm -rf /var/lib/apt/lists/*
# Bake the Gemma weights. gemma-2-9b-it is gated: the build needs an HF token
# (BuildKit secret `hf_token`) from an account that accepted the license, and
# the download failing fails the BUILD — a silently weightless image re-pulls
# 17GB on every cold start (and anonymously it just 429s; been there).
RUN --mount=type=secret,id=hf_token \
    uv sync --extra classifier --frozen \
    && if [ -n "${PRELOAD_EVENTS_MODEL}" ]; then \
      HF_TOKEN="$(cat /run/secrets/hf_token)" \
      .venv/bin/python -c 'import os; from huggingface_hub import snapshot_download; snapshot_download(os.environ["PRELOAD_EVENTS_MODEL"], token=os.environ.get("HF_TOKEN") or None); print("preloaded events model", os.environ["PRELOAD_EVENTS_MODEL"])'; \
    fi \
    && uv cache clean
CMD ["uv", "run", "python", "-m", "functions.classify_events"]
