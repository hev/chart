FROM python:3.14-slim-trixie@sha256:0514bc76712d64f8bb48adcb95b1ab0d88c69fee95d62fe4c18ee948bee9b1e1
WORKDIR /app
COPY scripts/luxir-demo-requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY --from=layer_client . /tmp/layer-client
RUN pip install --no-cache-dir /tmp/layer-client && rm -rf /tmp/layer-client
COPY chart_common chart_common
COPY search search
COPY web/static web/static
COPY demo demo
COPY scripts/luxir_demo.py scripts/luxir_demo.py
USER 10001:10001
ENV PYTHONDONTWRITEBYTECODE=1
CMD ["uvicorn", "search.app:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
