# CHART_OP_TIMEOUT_SECONDS=15

# Cloudflare Worker production search needs an embedding service for the exact
# Arctic v1.5 query vector; set these as Worker vars/secrets, not in browser code.
# CHART_QUERY_EMBED_URL=
# CHART_QUERY_EMBED_KEY=
