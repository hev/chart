# Copy to .env. The gateway key is the upstream Turbopuffer key (deriveFromStore
# auth) — 1Password: "layer turbopuffer" / mesh-staging vault. Never commit .env.
LAYER_GATEWAY_URL=https://aws-us-east-1.hevlayer.com
LAYER_GATEWAY_API_KEY=

# Optional overrides (defaults in chart_common/config.py):
# CHART_NAMESPACE=chart-notes
# CHART_EMBED_MODEL=Snowflake/snowflake-arctic-embed-m-v1.5

# Local smoke / gate controls:
# CHART_SLICE_LIMIT=2000
# CHART_SLICE_INDEX_REPORT=eval/out/slice-index-report.json
# CHART_REQUIRE_EVENT_FACETS=1
# CHART_LIVE_SMOKE_BASE_REPORT=eval/out/live-smoke-base-report.json
# CHART_LIVE_SMOKE_REPORT=eval/out/live-smoke-report.json
# CHART_FACET_REFRESH_REPORT=eval/out/facet-refresh-report.json
# CHART_EVAL_LIMIT=500
# CHART_EVAL_TOP_K=1000
# CHART_EVAL_HOLDOUT_MAX_OVERLAP=0
# CHART_EVAL_REQUIRE_NO_FAILURES=1
# CHART_EVAL_REQUIRE_FUSED_DOMINATES=1
# CHART_EVAL_HOLDOUT_REPORT=eval/out/holdout-report.json
# CHART_EVAL_RECDS_REPORT=eval/out/recds-report.json
# CHART_EVAL_BIMODAL_REPORT=eval/out/bimodal-report.json
# CHART_PREFLIGHT_DOCKER=1
# CHART_PREFLIGHT_LIVE=1
# CHART_LAYER_COST_WINDOW=24h

# Phase-6 cost-gated operations. Leave unset until the corresponding Layer cost
# gate has been accepted.
# CHART_ALLOW_FULL_CPU_INDEX=1
# CHART_ACCEPT_PHASE4_CLASSIFY_COST=1
# CHART_PHASE4_CLASSIFY_REPORT=eval/out/classify-events-budget.json
# CHART_APPLY_CLASSIFIER=1
# CHART_ACCEPT_PHASE6_EMBED_COST=1
# CHART_MEASURE_ACCELERATOR=gpu

# GPU worker overrides, mostly for local one-shot debugging.
# CHART_EVENTS_MODEL=google/gemma-2-9b-it
# CHART_ASSUME_CLASSIFIER_EXTRA=1
# CHART_EMBED_CLAIM_SIZE=64
# CHART_EMBED_BATCH_SIZE=32
# CHART_EMBED_LEASE_SECONDS=900
# CHART_EMBED_HEARTBEAT_SECONDS=60
# CHART_EMBED_POLL_SECONDS=2.0
# CHART_EMBED_SIMILAR_QRELS_SPLIT=train
# HEVLAYER_PIPELINE_ID=chart-notes
# HEVLAYER_WORKER_ID=

# Build/deploy overrides for the external Phase-6 gates.
# CHART_EMBED_IMAGE=186219257916.dkr.ecr.us-east-1.amazonaws.com/mesh:chart-embedder-plan-20260624-dedupe2
# CHART_SOURCE_IMAGE=186219257916.dkr.ecr.us-east-1.amazonaws.com/mesh:chart-huggingface-source-plan-20260624-concurrent
